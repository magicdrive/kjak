{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    "group:allNonMajor"
  ],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 10am on monday"],
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "prCreation": "immediate",
  "rebaseWhen": "behind-base-branch",
  "minimumReleaseAge": "3 days",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 10am on monday"]
  },
  "packageRules": [
    {
      "description": "The Renovate of make renovate-check (.github/renovate-check): package.json, its lockfile and the Node.js its engines require move together",
      "matchFileNames": [".github/renovate-check/**"],
      "groupName": "Renovate validator",
      "automerge": false
    },
    {
      "description": "The Node.js of make renovate-check must satisfy the engines of the pinned Renovate (test_run.py checks it; Renovate 44 requires ^24.11.0): a major is raised from the Dependency Dashboard, when a Renovate that supports it is pinned, not as a PR of its own that cannot pass",
      "matchFileNames": [".github/renovate-check/.node-version"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "GitHub Actions stay pinned to commit SHAs (magicdrive/hephaestus included)",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "pinDigests": true,
      "automerge": false
    },
    {
      "description": "Hephaestus: the action SHA in the workflows and HEPHAESTUS_VERSION in the Makefile move together",
      "matchPackageNames": ["magicdrive/hephaestus", "github.com/magicdrive/hephaestus"],
      "groupName": "Hephaestus",
      "automerge": false
    },
    {
      "description": "Go major updates monthly",
      "matchDatasources": ["go"],
      "matchUpdateTypes": ["major"],
      "groupName": "Go major dependencies",
      "schedule": ["before 10am on the first day of the month"]
    },
    {
      "description": "golang.org/x packages grouping",
      "matchDatasources": ["go"],
      "matchPackageNames": ["golang.org/x{/,}**"],
      "groupName": "golang.org/x packages",
      "automerge": false
    },
    {
      "description": "Vulnerable packages first",
      "matchDatasources": ["go"],
      "labels": ["security"],
      "prPriority": 10
    }
  ],
  "customManagers": [
    {
      "description": "Go tools pinned in the Makefile (pkg@version)",
      "customType": "regex",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": [
        "(?:STATICCHECK|GOVULNCHECK|ACTIONLINT|GOLANGCI_LINT) := (?<depName>[^@\\s]+?)(?:/cmd/[^@\\s]+)?@(?<currentValue>v[^\\s]+)"
      ],
      "datasourceTemplate": "go"
    },
    {
      "description": "Hephaestus CLI version in the Makefile",
      "customType": "regex",
      "managerFilePatterns": ["/^Makefile$/"],
      "matchStrings": ["HEPHAESTUS_VERSION \\?= (?<currentValue>v[^\\s]+)"],
      "depNameTemplate": "github.com/magicdrive/hephaestus",
      "datasourceTemplate": "go"
    }
  ],
  "ignorePaths": ["**/testdata/**"],
  "postUpdateOptions": ["gomodTidy"],
  "osvVulnerabilityAlerts": true
}
